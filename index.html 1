function solveSection2D(data,cutMembers,baseResult){
  if(cutMembers.length===0) throw new Error('請輸入切割桿件');
  if(cutMembers.length>3) throw new Error('截面法一次建議切過不超過 3 根桿件');
  cutMembers.forEach(mid=>{if(!data.members[mid]) throw new Error(`找不到桿件 ${mid}`);});
  const graph={}; Object.keys(data.nodes).forEach(n=>graph[n]=new Set());
  Object.entries(data.members).forEach(([mid,m])=>{ if(cutMembers.includes(mid)) return; graph[m.n1].add(m.n2); graph[m.n2].add(m.n1); });
  const comps=[], unvisited=new Set(Object.keys(data.nodes));
  while(unvisited.size){ const start=[...unvisited][0], stack=[start], comp=new Set([start]); unvisited.delete(start); while(stack.length){ const cur=stack.pop(); graph[cur].forEach(nb=>{ if(unvisited.has(nb)){unvisited.delete(nb); comp.add(nb); stack.push(nb);} }); } comps.push(comp); }
  if(comps.length!==2) throw new Error('這組切割桿件移除後沒有把桁架分成剛好兩部分，請重新選擇。');
  const side = comps[0].size<=comps[1].size?comps[0]:comps[1]; const other = side===comps[0]?comps[1]:comps[0];
  cutMembers.forEach(mid=>{ const m=data.members[mid]; if(side.has(m.n1)===side.has(m.n2)) throw new Error(`桿件 ${mid} 沒有跨越截面兩側`); });
  const rlist=buildReactions2D(data); const known=[];
  side.forEach(node=>{ const p=data.nodes[node], L=data.loads[node]||{fx:0,fy:0}; if(Math.abs(L.fx)>EPS||Math.abs(L.fy)>EPS) known.push({label:`外力@${node}`,node,x:p.x,y:p.y,fx:L.fx,fy:L.fy}); rlist.forEach(r=>{if(r.node===node){ const val=baseResult.reactions[r.name]||0; if(Math.abs(val)>EPS) known.push({label:r.name,node,x:p.x,y:p.y,fx:val*r.ux,fy:val*r.uy});}}); });
  const unknowns=cutMembers.map(mid=>{ const m=data.members[mid]; let sideNode,outNode; if(side.has(m.n1)){sideNode=m.n1; outNode=m.n2;} else {sideNode=m.n2; outNode=m.n1;} const u=unit2D(data,sideNode,outNode), p=data.nodes[sideNode]; return {mid,sideNode,x:p.x,y:p.y,ux:u.ux,uy:u.uy}; });
  const rows=[], rhs=[], eqs=[];
  function addFx(){ const coeff=unknowns.map(u=>u.ux); const k=known.reduce((s,f)=>s+f.fx,0); rows.push(coeff); rhs.push(-k); eqs.push(makeSecEq('ΣFx',unknowns,coeff,k)); }
  function addFy(){ const coeff=unknowns.map(u=>u.uy); const k=known.reduce((s,f)=>s+f.fy,0); rows.push(coeff); rhs.push(-k); eqs.push(makeSecEq('ΣFy',unknowns,coeff,k)); }
  function addM(o){ const op=data.nodes[o]; const coeff=unknowns.map(u=>(u.x-op.x)*u.uy-(u.y-op.y)*u.ux); const k=known.reduce((s,f)=>s+(f.x-op.x)*f.fy-(f.y-op.y)*f.fx,0); rows.push(coeff); rhs.push(-k); eqs.push(makeSecEq(`ΣM_${o}`,unknowns,coeff,k)); }
  addFx(); addFy(); [...side].sort().forEach(addM);
  const n=cutMembers.length; let chosen=null, sol=null;
  for(const comb of combinations(rows.map((_,i)=>i),n)){ const sub=comb.map(i=>rows[i]); if(rankOf(sub)===n){ chosen=comb; sol=solveSquare(sub,comb.map(i=>rhs[i])); break; } }
  if(!chosen) throw new Error('此截面方程式無法獨立求出所有切割桿件，請改選截面。');
  const vals={}; cutMembers.forEach((mid,i)=>vals[mid]=sol[i]);
  let text='【6.4 截面法 Method of Sections】\n';
  text+=`切割桿件：${cutMembers.join(', ')}\nA側節點：${[...side].sort().join(', ')}\nB側節點：${[...other].sort().join(', ')}\n\n`;
  text+='已知作用在選定自由體上的外力與反力：\n'; text+=known.length?known.map(f=>`  ${f.label}: Fx=${fmt(f.fx)}, Fy=${fmt(f.fy)}`).join('\n'):'  此側無外力與支承反力。';
  text+='\n\n選用平衡式：\n'+chosen.map(i=>'  '+eqs[i]).join('\n')+'\n\n解得：\n';
  text+=cutMembers.map(mid=>`  ${mid} = ${fmt(vals[mid])}，${forceState(vals[mid])}（節點法比對：${fmt(baseResult.memberForces[mid])}）`).join('\n');
  return {values:vals,text};
}
function makeSecEq(title,unknowns,coeff,known){ const left=unknowns.map((u,i)=>Math.abs(coeff[i])>1e-10?term(coeff[i],u.mid):'').filter(Boolean).join(' ')||'0'; return `${title}: ${left} ${signed(known)} = 0`; }

