function draw2D(data,forces,cutSet){
  const cv=$('canvas'), ctx=cv.getContext('2d'); ctx.clearRect(0,0,cv.width,cv.height);
  const nodes=Object.values(data.nodes), xs=nodes.map(p=>p.x), ys=nodes.map(p=>p.y); const minX=Math.min(...xs), maxX=Math.max(...xs), minY=Math.min(...ys), maxY=Math.max(...ys);
  const pad=55, sx=(cv.width-2*pad)/Math.max(maxX-minX,1), sy=(cv.height-2*pad)/Math.max(maxY-minY,1), sc=Math.min(sx,sy);
  function P(p){ return {x:pad+(p.x-minX)*sc, y:cv.height-pad-(p.y-minY)*sc}; }
  const vals=forces?Object.values(forces).map(Math.abs):[1], maxF=Math.max(...vals,1);
  ctx.font='14px Arial'; ctx.lineCap='round';
  Object.entries(data.members).forEach(([mid,m])=>{
    const a=P(data.nodes[m.n1]), b=P(data.nodes[m.n2]); const f=forces?forces[mid]:0;
    ctx.strokeStyle=!forces?'gray':Math.abs(f)<1e-6?'gray':f>0?'red':'blue'; ctx.lineWidth=!forces?3:3+5*Math.abs(f)/maxF;
    if(cutSet&&cutSet.has(mid)) ctx.setLineDash([10,7]); else ctx.setLineDash([]);
    ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke(); ctx.setLineDash([]);
    const mx=(a.x+b.x)/2, my=(a.y+b.y)/2; ctx.fillStyle='rgba(255,255,255,.82)'; ctx.fillRect(mx-32,my-18,64,34); ctx.fillStyle='#111'; ctx.textAlign='center'; ctx.fillText(mid,mx,my-3); if(forces) ctx.fillText(fmt(f),mx,my+13);
  });
  // supports
  Object.entries(data.supports).forEach(([n,type])=>{ const p=P(data.nodes[n]); ctx.strokeStyle='#111'; ctx.fillStyle='#111'; ctx.lineWidth=2; if(type.includes('pin')){ ctx.beginPath(); ctx.moveTo(p.x,p.y+8); ctx.lineTo(p.x-12,p.y+30); ctx.lineTo(p.x+12,p.y+30); ctx.closePath(); ctx.fill(); }else if(type.includes('roller_x')||type==='x'){ ctx.beginPath(); ctx.arc(p.x-18,p.y,8,0,Math.PI*2); ctx.stroke(); }else{ ctx.beginPath(); ctx.arc(p.x,p.y+22,8,0,Math.PI*2); ctx.stroke(); }});
  // loads
  const maxLoad=Math.max(...Object.values(data.loads).map(L=>Math.hypot(L.fx,L.fy)),1); const arrowScale=45/maxLoad;
  Object.entries(data.loads).forEach(([n,L])=>{ if(Math.hypot(L.fx,L.fy)<EPS) return; const p=P(data.nodes[n]); drawArrow(ctx,p.x,p.y,p.x+L.fx*arrowScale,p.y-L.fy*arrowScale,'green',3); ctx.fillStyle='green'; ctx.fillText(`P(${fmt(L.fx)},${fmt(L.fy)})`,p.x+L.fx*arrowScale,p.y-L.fy*arrowScale-6); });
  // nodes
  Object.entries(data.nodes).forEach(([n,p0])=>{ const p=P(p0); ctx.fillStyle='#111'; ctx.beginPath(); ctx.arc(p.x,p.y,6,0,Math.PI*2); ctx.fill(); ctx.fillStyle='#111'; ctx.font='bold 16px Arial'; ctx.textAlign='center'; ctx.fillText(n,p.x,p.y-12); });
}
function drawArrow(ctx,x1,y1,x2,y2,color,lw){ ctx.strokeStyle=color; ctx.fillStyle=color; ctx.lineWidth=lw; ctx.beginPath(); ctx.moveTo(x1,y1); ctx.lineTo(x2,y2); ctx.stroke(); const ang=Math.atan2(y2-y1,x2-x1); const h=11; ctx.beginPath(); ctx.moveTo(x2,y2); ctx.lineTo(x2-h*Math.cos(ang-Math.PI/6),y2-h*Math.sin(ang-Math.PI/6)); ctx.lineTo(x2-h*Math.cos(ang+Math.PI/6),y2-h*Math.sin(ang+Math.PI/6)); ctx.closePath(); ctx.fill(); }

function drawJointDiagram(){
  try{
    const data=parse2D(); updateJointSelect(data); let result=state2D.result; if(!result||!result.success) result=solve2D(data); const node=$('jointSelect').value||Object.keys(data.nodes)[0];
    const cv=$('canvas'), ctx=cv.getContext('2d'); ctx.clearRect(0,0,cv.width,cv.height); const cx=cv.width/2, cy=cv.height/2, R=140;
