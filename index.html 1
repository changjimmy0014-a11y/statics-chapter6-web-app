<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>靜力學第六章｜結構分析輔助教學網頁版</title>
  <style>
    :root{
      --bg:#f4f6f8; --card:#fff; --ink:#1f2937; --muted:#6b7280; --line:#d1d5db;
      --brand:#1d4ed8; --brand2:#0f766e; --danger:#dc2626; --blue:#2563eb; --gray:#6b7280;
      --soft:#eef2ff; --ok:#16a34a; --warn:#d97706;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:system-ui,-apple-system,"Segoe UI","Noto Sans TC",Arial,sans-serif;background:var(--bg);color:var(--ink)}
    header{padding:18px 24px;background:linear-gradient(120deg,#0f172a,#1d4ed8);color:#fff}
    header h1{margin:0;font-size:24px;letter-spacing:.03em}
    header p{margin:6px 0 0;color:#dbeafe;font-size:14px}
    .wrap{max-width:1480px;margin:0 auto;padding:16px}
    .toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
    button{border:0;border-radius:10px;padding:9px 13px;background:var(--brand);color:#fff;font-weight:700;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.12)}
    button.secondary{background:var(--brand2)}
    button.light{background:#fff;color:var(--ink);border:1px solid var(--line);box-shadow:none}
    button.warn{background:var(--warn)}
    button:hover{filter:brightness(.95)}
    .grid{display:grid;grid-template-columns:430px 1fr;gap:14px}
    .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:0 4px 14px rgba(15,23,42,.05);overflow:hidden}
    .panel h2{margin:0;padding:12px 14px;border-bottom:1px solid var(--line);font-size:17px;background:#f9fafb}
    .panel-body{padding:12px}
    .tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:10px;background:#f9fafb}
    .tab-btn{background:#fff;color:var(--ink);border:1px solid var(--line);box-shadow:none;padding:8px 10px;border-radius:999px;font-size:13px}
    .tab-btn.active{background:var(--brand);color:#fff;border-color:var(--brand)}
    .tab{display:none}.tab.active{display:block}
    label{display:block;font-weight:700;font-size:13px;margin:10px 0 5px}
    textarea,input,select{width:100%;border:1px solid var(--line);border-radius:10px;padding:9px;font-family:"Consolas","Noto Sans TC",monospace;font-size:13px;background:#fff;color:var(--ink)}
    textarea{min-height:90px;resize:vertical}
    .hint{font-size:12px;color:var(--muted);margin:4px 0 8px;line-height:1.5}
    .small-row{display:grid;grid-template-columns:1fr 120px;gap:8px;align-items:end}
    canvas{width:100%;height:480px;background:#fff;border:1px solid var(--line);border-radius:12px;display:block}
    .results{display:grid;grid-template-columns:1fr 1.2fr;gap:10px;margin-top:10px}
    table{border-collapse:collapse;width:100%;font-size:13px;background:#fff;border-radius:10px;overflow:hidden}
    th,td{border:1px solid var(--line);padding:7px;text-align:center}
    th{background:#f3f4f6}
    .stateT{color:var(--danger);font-weight:700}.stateC{color:var(--blue);font-weight:700}.stateZ{color:var(--gray);font-weight:700}
    pre{white-space:pre-wrap;line-height:1.55;background:#0b1020;color:#e5e7eb;border-radius:12px;padding:12px;max-height:430px;overflow:auto;font-size:13px}
    .two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
    .badge{display:inline-block;border-radius:999px;padding:3px 8px;font-size:12px;background:var(--soft);color:var(--brand);font-weight:700;margin-left:4px}
    .legend{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;margin:8px 0;color:var(--muted)}
    .sw{display:inline-block;width:22px;height:4px;border-radius:10px;vertical-align:middle;margin-right:5px}.red{background:red}.blue{background:blue}.gray{background:gray}.green{background:green}
    .notice{padding:10px;border-radius:10px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;font-size:13px;line-height:1.6}
    footer{padding:14px;text-align:center;color:var(--muted);font-size:12px}
    @media(max-width:1050px){.grid{grid-template-columns:1fr}.results{grid-template-columns:1fr}.two,.three{grid-template-columns:1fr}canvas{height:420px}}
  </style>
</head>
<body>
<header>
  <h1>靜力學第六章｜結構分析輔助教學網頁版</h1>
  <p>支援：6.1 簡單桁架、6.2 接點法、6.3 零力構件、6.4 截面法、6.5 空間桁架、6.6 構架與機具輔助</p>
</header>

<div class="wrap">
  <div class="toolbar">
    <button onclick="loadExample2D()">載入平面桁架範例</button>
    <button onclick="analyze2D()">節點法分析</button>
    <button onclick="analyzeSection()" class="secondary">截面法分析</button>
    <button onclick="drawJointDiagram()" class="warn">繪製接點受力圖</button>
    <button onclick="clear2D()" class="light">清空平面資料</button>
  </div>

  <div class="grid">
    <section class="panel">
      <div class="tabs">
        <button class="tab-btn active" onclick="showTab('input2d',this)">平面桁架輸入</button>
        <button class="tab-btn" onclick="showTab('sectionTab',this)">截面法 / 接點圖</button>
        <button class="tab-btn" onclick="showTab('space3d',this)">6.5 空間桁架</button>
        <button class="tab-btn" onclick="showTab('frameMachine',this)">6.6 構架與機具</button>
        <button class="tab-btn" onclick="showTab('chapter6',this)">第六章說明</button>
      </div>

      <div class="panel-body">
        <div id="input2d" class="tab active">
          <label>節點座標 node,x,y</label>
          <textarea id="nodes2d"></textarea>
          <div class="hint">例如：A,0,0。座標單位可視為 m。</div>

          <label>桿件 member,node_i,node_j</label>
          <textarea id="members2d"></textarea>

          <label>支承 node,pin / roller_y / roller_x</label>
          <textarea id="supports2d"></textarea>
          <div class="hint">pin 有 x、y 兩個反力；roller_y 只有垂直反力；roller_x 只有水平反力。</div>

          <label>外力 node,Fx,Fy</label>
          <textarea id="loads2d"></textarea>
          <div class="hint">向右為 +Fx，向上為 +Fy，向下力請輸入負值。</div>
        </div>

        <div id="sectionTab" class="tab">
          <label>截面法切割桿件</label>
          <input id="cutMembers" value="AB,BC,EC" />
          <div class="hint">一次建議切 1～3 根桿件，且移除後要能把桁架分成兩個自由體。</div>

          <label>接點受力圖：選擇節點</label>
          <div class="small-row">
            <select id="jointSelect"></select>
            <button onclick="drawJointDiagram()">繪製</button>
          </div>
          <div class="notice" style="margin-top:12px">
            接點受力圖是用來對照 6.2 接點法：每個節點列 ΣFx=0、ΣFy=0。桿件力正值預設沿桿件向外拉。
          </div>
        </div>

        <div id="space3d" class="tab">
          <div class="toolbar">
            <button onclick="loadExample3D()">載入 3D 範例</button>
            <button onclick="analyze3D()">求解空間桁架</button>
          </div>
          <label>3D 節點 node,x,y,z</label>
          <textarea id="nodes3d"></textarea>
          <label>3D 桿件 member,node_i,node_j</label>
          <textarea id="members3d"></textarea>
          <label>3D 支承 node,xyz / xz / z</label>
          <textarea id="supports3d"></textarea>
          <label>3D 外力 node,Fx,Fy,Fz</label>
          <textarea id="loads3d"></textarea>
          <div class="hint">空間桁架每個節點建立三條方程式：ΣFx=0、ΣFy=0、ΣFz=0。</div>
        </div>

        <div id="frameMachine" class="tab">
          <button onclick="generateFrameNotes()">產生構架與機具解題提醒</button>
          <label>題目整理區</label>
          <textarea id="frameInput" style="min-height:260px"></textarea>
          <div class="hint">此頁是 6.6 的 FBD 輔助整理。構架與機具常需要拆成多個剛體分別列 ΣFx、ΣFy、ΣM。</div>
        </div>

        <div id="chapter6" class="tab">
          <pre id="chapter6Text"></pre>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2>圖形顯示 <span class="badge">紅=受拉</span><span class="badge">藍=受壓</span><span class="badge">灰=零力/未求解</span></h2>
      <div class="panel-body">
        <div class="legend">
          <span><i class="sw red"></i>受拉 Tension</span>
          <span><i class="sw blue"></i>受壓 Compression</span>
          <span><i class="sw gray"></i>零力桿 / 未求解</span>
          <span><i class="sw green"></i>外力</span>
        </div>
        <canvas id="canvas" width="980" height="520"></canvas>
        <div class="results">
          <div>
            <h3>支承反力</h3>
            <div id="reactionTable"></div>
          </div>
          <div>
            <h3>桿件內力</h3>
            <div id="forceTable"></div>
          </div>
        </div>
        <h3>計算過程 / 教學說明</h3>
        <pre id="log"></pre>
      </div>
    </section>
  </div>
</div>
<footer>Static web app｜可直接部署到 GitHub Pages / Netlify / Vercel</footer>

<script>
const EPS = 1e-9;
let state2D = {data:null, result:null, cut:null};
let state3D = {data:null, result:null};

function $(id){ return document.getElementById(id); }
function fmt(v){ if(!isFinite(v)) return String(v); return (Math.abs(v)<1e-8?0:v).toFixed(3); }
function cleanLine(s){ return s.trim().replaceAll('，', ',').split('#')[0].trim(); }
function forceState(v){ if(Math.abs(v)<1e-6) return '零力桿'; return v>0?'受拉 Tension':'受壓 Compression'; }
function stateClass(v){ if(Math.abs(v)<1e-6) return 'stateZ'; return v>0?'stateT':'stateC'; }
function signed(v){ return v>=0?`+ ${fmt(v)}`:`- ${fmt(Math.abs(v))}`; }
function term(c,name){ if(Math.abs(c)<1e-10) return ''; return `${c>=0?'+':'-'} ${fmt(Math.abs(c))}${name}`; }
function showTab(id, btn){ document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active')); $(id).classList.add('active'); document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); if(id==='chapter6') updateChapter6Text(); }

function combinations(arr, k){
  const res=[];
  function back(start, cur){
    if(cur.length===k){ res.push(cur.slice()); return; }
    for(let i=start;i<arr.length;i++){ cur.push(arr[i]); back(i+1,cur); cur.pop(); }
  }
  back(0,[]); return res;
}

function rankOf(M){
  const A = M.map(r=>r.slice());
  const rows=A.length, cols=A[0]?.length||0;
  let r=0;
  for(let c=0;c<cols && r<rows;c++){
    let piv=r;
    for(let i=r+1;i<rows;i++) if(Math.abs(A[i][c])>Math.abs(A[piv][c])) piv=i;
    if(Math.abs(A[piv][c])<1e-10) continue;
    [A[r],A[piv]]=[A[piv],A[r]];
    const div=A[r][c];
    for(let j=c;j<cols;j++) A[r][j]/=div;
    for(let i=0;i<rows;i++) if(i!==r){
      const f=A[i][c];
      if(Math.abs(f)>1e-12) for(let j=c;j<cols;j++) A[i][j]-=f*A[r][j];
    }
    r++;
  }
  return r;
}

function solveSquare(A,b){
  const n=A.length;
  const M=A.map((r,i)=>r.slice().concat([b[i]]));
  for(let c=0;c<n;c++){
    let piv=c;
    for(let i=c+1;i<n;i++) if(Math.abs(M[i][c])>Math.abs(M[piv][c])) piv=i;
    if(Math.abs(M[piv][c])<1e-10) throw new Error('矩陣奇異，無法唯一求解');
    [M[c],M[piv]]=[M[piv],M[c]];
    const div=M[c][c];
    for(let j=c;j<=n;j++) M[c][j]/=div;
    for(let i=0;i<n;i++) if(i!==c){
      const f=M[i][c];
      for(let j=c;j<=n;j++) M[i][j]-=f*M[c][j];
    }
  }
  return M.map(r=>r[n]);
}

function transpose(A){ return A[0].map((_,c)=>A.map(r=>r[c])); }
function matMul(A,B){ return A.map(r=>B[0].map((_,c)=>r.reduce((s,v,k)=>s+v*B[k][c],0))); }
function matVec(A,x){ return A.map(r=>r.reduce((s,v,k)=>s+v*x[k],0)); }
function leastSquares(A,b){
  const At=transpose(A);
  const AtA=matMul(At,A);
  const Atb=At.map(r=>r.reduce((s,v,k)=>s+v*b[k],0));
  return solveSquare(AtA,Atb);
}
function norm(v){ return Math.sqrt(v.reduce((s,x)=>s+x*x,0)); }

function parse2D(){
  const nodes={};
  $('nodes2d').value.split('\n').forEach(raw=>{
    const line=cleanLine(raw); if(!line) return;
    const p=line.split(',').map(x=>x.trim());
    if(p.length!==3) throw new Error(`節點格式錯誤：${raw}`);
    nodes[p[0]]={x:Number(p[1]),y:Number(p[2])};
  });
  const members={};
  $('members2d').value.split('\n').forEach(raw=>{
    const line=cleanLine(raw); if(!line) return;
    const p=line.split(',').map(x=>x.trim());
    if(p.length!==3) throw new Error(`桿件格式錯誤：${raw}`);
    if(!nodes[p[1]]||!nodes[p[2]]) throw new Error(`桿件 ${p[0]} 的節點不存在`);
    members[p[0]]={id:p[0],n1:p[1],n2:p[2]};
  });
  const supports={};
  $('supports2d').value.split('\n').forEach(raw=>{
    const line=cleanLine(raw); if(!line) return;
    const p=line.split(',').map(x=>x.trim());
    if(p.length!==2) throw new Error(`支承格式錯誤：${raw}`);
    if(!nodes[p[0]]) throw new Error(`支承節點 ${p[0]} 不存在`);
    supports[p[0]]=p[1].toLowerCase();
  });
  const loads={}; Object.keys(nodes).forEach(n=>loads[n]={fx:0,fy:0});
  $('loads2d').value.split('\n').forEach(raw=>{
    const line=cleanLine(raw); if(!line) return;
    const p=line.split(',').map(x=>x.trim());
    if(p.length!==3) throw new Error(`外力格式錯誤：${raw}`);
    if(!nodes[p[0]]) throw new Error(`外力節點 ${p[0]} 不存在`);
    loads[p[0]].fx += Number(p[1]); loads[p[0]].fy += Number(p[2]);
  });
  if(Object.keys(nodes).length===0 || Object.keys(members).length===0) throw new Error('請至少輸入節點與桿件');
  return {nodes,members,supports,loads};
}

function buildReactions2D(data){
  const out=[];
  Object.entries(data.supports).forEach(([node,type])=>{
    if(['pin','hinge','鉸','鉸支承'].includes(type)){
      out.push({name:`R_${node}x`,node,ux:1,uy:0}); out.push({name:`R_${node}y`,node,ux:0,uy:1});
    }else if(['roller_y','roller','y','vertical'].includes(type)){
      out.push({name:`R_${node}y`,node,ux:0,uy:1});
    }else if(['roller_x','x','horizontal'].includes(type)){
      out.push({name:`R_${node}x`,node,ux:1,uy:0});
    }else throw new Error(`支承型式 ${type} 無法辨識`);
  });
  return out;
}
function unit2D(data,a,b){
  const p=data.nodes[a], q=data.nodes[b]; const dx=q.x-p.x, dy=q.y-p.y; const L=Math.hypot(dx,dy);
  if(L<EPS) throw new Error(`節點 ${a} 與 ${b} 重合`);
  return {ux:dx/L,uy:dy/L,L};
}
function unitAtJoint(data,m,j){
  if(j===m.n1) return unit2D(data,m.n1,m.n2);
  if(j===m.n2) return unit2D(data,m.n2,m.n1);
  throw new Error(`${m.id} 不連接 ${j}`);
}
function incident(data,node){ return Object.keys(data.members).filter(mid=>data.members[mid].n1===node||data.members[mid].n2===node); }
function collinear(data,m1,m2,node){ const a=unitAtJoint(data,m1,node), b=unitAtJoint(data,m2,node); return Math.abs(a.ux*b.uy-a.uy*b.ux)<1e-6; }

function detectZero2D(data){
  const zero=new Set(), info=[]; let changed=true;
  while(changed){
    changed=false;
    for(const node of Object.keys(data.nodes)){
      const L=data.loads[node]||{fx:0,fy:0};
      if(Math.abs(L.fx)>EPS||Math.abs(L.fy)>EPS||data.supports[node]) continue;
      const inc=incident(data,node).filter(mid=>!zero.has(mid));
      if(inc.length===2){
        const m1=data.members[inc[0]], m2=data.members[inc[1]];
        if(!collinear(data,m1,m2,node)){
          inc.forEach(mid=>{if(!zero.has(mid)){zero.add(mid);changed=true;}});
          info.push(`節點 ${node} 只有兩根非共線桿件 ${inc[0]}, ${inc[1]}，且無外力與支承，因此兩者為零力桿。`);
        }
      }else if(inc.length===3){
        for(const [a,b] of combinations(inc,2)){
          if(collinear(data,data.members[a],data.members[b],node)){
            const third=inc.find(x=>x!==a&&x!==b);
            if(!zero.has(third)){ zero.add(third); changed=true; info.push(`節點 ${node} 的 ${a}, ${b} 共線，且無外力與支承，因此 ${third} 為零力桿。`); }
            break;
          }
        }
      }
    }
  }
  if(info.length===0) info.push('未由基本規則直接辨識到零力桿。');
  return {zero,info};
}

function solve2D(data){
  const nodes=Object.keys(data.nodes), mids=Object.keys(data.members), reactions=buildReactions2D(data);
  const unknowns=mids.concat(reactions.map(r=>r.name));
  const rows=2*nodes.length, cols=unknowns.length;
  const A=Array.from({length:rows},()=>Array(cols).fill(0)); const b=Array(rows).fill(0);
  const rowFx=n=>2*nodes.indexOf(n), rowFy=n=>2*nodes.indexOf(n)+1;
  nodes.forEach(n=>{ const L=data.loads[n]||{fx:0,fy:0}; b[rowFx(n)] = -L.fx; b[rowFy(n)] = -L.fy; });
  mids.forEach((mid,c)=>{
    const m=data.members[mid], u=unit2D(data,m.n1,m.n2);
    A[rowFx(m.n1)][c]+=u.ux; A[rowFy(m.n1)][c]+=u.uy;
    A[rowFx(m.n2)][c]-=u.ux; A[rowFy(m.n2)][c]-=u.uy;
  });
  reactions.forEach((r,k)=>{ const c=mids.length+k; A[rowFx(r.node)][c]+=r.ux; A[rowFy(r.node)][c]+=r.uy; });
  const rank=rankOf(A);
  const zr=detectZero2D(data);
  const equations=[];
  nodes.forEach(n=>{
    [['ΣFx',rowFx(n)],['ΣFy',rowFy(n)]].forEach(([dir,row])=>{
      let left=[]; unknowns.forEach((name,c)=>{ const t=term(A[row][c],name); if(t) left.push(t); });
      const load = -b[row]; equations.push(`節點 ${n} ${dir}: ${left.join(' ')||'0'} ${signed(load)} = 0`);
    });
  });
  if(rank<cols) return {success:false,message:`求解失敗：矩陣 rank=${rank}，未知數=${cols}。可能不穩定、支承不足或靜不定。`,equations,zeroInfo:zr.info};
  let x;
  if(rows===cols) x=solveSquare(A,b); else x=leastSquares(A,b);
  const residual=norm(matVec(A,x).map((v,i)=>v-b[i]));
  const values={}; unknowns.forEach((name,i)=>values[name]=x[i]);
  const memberForces={}; mids.forEach(mid=>memberForces[mid]=values[mid]);
  const reactionValues={}; reactions.forEach(r=>reactionValues[r.name]=values[r.name]);
  const steps=makeJointSteps(data,memberForces,reactionValues,reactions,zr.zero);
  return {success:true,rank,residual,unknowns,values,memberForces,reactions:reactionValues,reactionList:reactions,equations,zeroInfo:zr.info,zeroSet:zr.zero,steps};
}

function makeJointSteps(data,memberForces,reactions,reactionList,zeroSet){
  const steps=[]; const solved=new Set([...zeroSet]);
  if(zeroSet.size) steps.push(`先由零力桿規則得到：${[...zeroSet].join(', ')} = 0。`);
  const nodes=Object.keys(data.nodes);
  for(let pass=0; pass<Object.keys(data.members).length+5; pass++){
    let progressed=false;
    for(const node of nodes){
      const inc=incident(data,node); const unknown=inc.filter(mid=>!solved.has(mid));
      if(unknown.length===0 || unknown.length>2) continue;
      let kfx=(data.loads[node]?.fx)||0, kfy=(data.loads[node]?.fy)||0;
      reactionList.forEach(r=>{ if(r.node===node){ const rv=reactions[r.name]||0; kfx+=rv*r.ux; kfy+=rv*r.uy; }});
      const knownLines=[];
      inc.forEach(mid=>{ if(solved.has(mid)){ const u=unitAtJoint(data,data.members[mid],node); const f=memberForces[mid]; kfx+=f*u.ux; kfy+=f*u.uy; knownLines.push(`${mid}=${fmt(f)}`); }});
      const coeffs=unknown.map(mid=>{ const u=unitAtJoint(data,data.members[mid],node); return {mid,ux:u.ux,uy:u.uy}; });
      const fxTerms=coeffs.map(c=>Math.abs(c.ux)>1e-10?term(c.ux,c.mid):'').filter(Boolean).join(' ')||'0';
      const fyTerms=coeffs.map(c=>Math.abs(c.uy)>1e-10?term(c.uy,c.mid):'').filter(Boolean).join(' ')||'0';
      const lines=[`選節點 ${node}：此節點剩下未知桿件 ${unknown.join(', ')}，可用 ΣFx=0、ΣFy=0 解。`];
      if(knownLines.length) lines.push(`已知桿件：${knownLines.join(', ')}`);
      lines.push(`ΣFx: ${fxTerms} ${signed(kfx)} = 0`);
      lines.push(`ΣFy: ${fyTerms} ${signed(kfy)} = 0`);
      unknown.forEach(mid=>lines.push(`解得 ${mid} = ${fmt(memberForces[mid])}，${forceState(memberForces[mid])}。`));
      steps.push(lines.join('\n')); unknown.forEach(mid=>solved.add(mid)); progressed=true;
    }
    if(!progressed) break;
  }
  const remain=Object.keys(data.members).filter(mid=>!solved.has(mid));
  if(remain.length) steps.push(`下列桿件無法用「每次只剩 1～2 個未知數的節點」排序：${remain.join(', ')}。程式已用整體節點平衡矩陣求解。`);
  return steps;
}

