// 3D
function parse3D(){
  const nodes={}; $('nodes3d').value.split('\n').forEach(raw=>{ const line=cleanLine(raw); if(!line)return; const p=line.split(',').map(x=>x.trim()); if(p.length!==4) throw new Error(`3D節點格式錯誤：${raw}`); nodes[p[0]]={x:+p[1],y:+p[2],z:+p[3]}; });
  const members={}; $('members3d').value.split('\n').forEach(raw=>{ const line=cleanLine(raw); if(!line)return; const p=line.split(',').map(x=>x.trim()); if(p.length!==3) throw new Error(`3D桿件格式錯誤：${raw}`); members[p[0]]={id:p[0],n1:p[1],n2:p[2]}; });
  const supports=[]; $('supports3d').value.split('\n').forEach(raw=>{ const line=cleanLine(raw).toLowerCase(); if(!line)return; const p=line.split(',').map(x=>x.trim()); if(p.length!==2) throw new Error(`3D支承格式錯誤：${raw}`); const node=p[0].toUpperCase(); for(const d of p[1]){ if(!'xyz'.includes(d)) throw new Error('支承方向只能為 x/y/z'); supports.push({name:`R_${node}${d}`,node,dir:d}); }});
  const loads={}; Object.keys(nodes).forEach(n=>loads[n]={fx:0,fy:0,fz:0}); $('loads3d').value.split('\n').forEach(raw=>{ const line=cleanLine(raw); if(!line)return; const p=line.split(',').map(x=>x.trim()); if(p.length!==4) throw new Error(`3D外力格式錯誤：${raw}`); loads[p[0]].fx+=+p[1]; loads[p[0]].fy+=+p[2]; loads[p[0]].fz+=+p[3]; });
  return {nodes,members,supports,loads};
}
function unit3D(data,a,b){ const p=data.nodes[a],q=data.nodes[b], dx=q.x-p.x,dy=q.y-p.y,dz=q.z-p.z,L=Math.hypot(dx,dy,dz); if(L<EPS) throw new Error('3D桿件長度為0'); return {ux:dx/L,uy:dy/L,uz:dz/L,L}; }
function solve3D(data){
  const nodes=Object.keys(data.nodes), mids=Object.keys(data.members), unknowns=mids.concat(data.supports.map(r=>r.name)); const A=Array.from({length:3*nodes.length},()=>Array(unknowns.length).fill(0)), b=Array(3*nodes.length).fill(0); const row=n=>3*nodes.indexOf(n);
  nodes.forEach(n=>{ const L=data.loads[n]||{fx:0,fy:0,fz:0}; b[row(n)]=-L.fx; b[row(n)+1]=-L.fy; b[row(n)+2]=-L.fz; });
  mids.forEach((mid,c)=>{ const m=data.members[mid], u=unit3D(data,m.n1,m.n2); A[row(m.n1)][c]+=u.ux; A[row(m.n1)+1][c]+=u.uy; A[row(m.n1)+2][c]+=u.uz; A[row(m.n2)][c]-=u.ux; A[row(m.n2)+1][c]-=u.uy; A[row(m.n2)+2][c]-=u.uz; });
  data.supports.forEach((r,k)=>{ const c=mids.length+k, rr=row(r.node); if(r.dir==='x')A[rr][c]=1; if(r.dir==='y')A[rr+1][c]=1; if(r.dir==='z')A[rr+2][c]=1; });
  const rank=rankOf(A); if(rank<unknowns.length) return {success:false,message:`求解失敗：rank=${rank}，未知數=${unknowns.length}。可能不穩定或靜不定。`};
  const x=A.length===unknowns.length?solveSquare(A,b):leastSquares(A,b); const values={}; unknowns.forEach((u,i)=>values[u]=x[i]); const mf={}; mids.forEach(mid=>mf[mid]=values[mid]); const rv={}; data.supports.forEach(r=>rv[r.name]=values[r.name]); return {success:true,rank,residual:norm(matVec(A,x).map((v,i)=>v-b[i])),values,memberForces:mf,reactions:rv};
}
function analyze3D(){
  try{ const data=parse3D(); const res=solve3D(data); state3D={data,result:res}; draw3D(data,res.success?res.memberForces:null); if(!res.success){ log('【6.5 空間桁架】\n'+res.message); return; } let out=`【6.5 空間桁架 Space Trusses】\n節點數 j=${Object.keys(data.nodes).length}，桿件數 m=${Object.keys(data.members).length}，支承反力數 r=${data.supports.length}\nm+r=${Object.keys(data.members).length+data.supports.length}，3j=${3*Object.keys(data.nodes).length}\nrank=${res.rank}，殘差 norm=${res.residual.toExponential(3)}\n\n桿件內力：\n`; Object.entries(res.memberForces).forEach(([k,v])=>out+=`  ${k} = ${fmt(v)}，${forceState(v)}\n`); out+='\n支承反力：\n'; Object.entries(res.reactions).forEach(([k,v])=>out+=`  ${k} = ${fmt(v)}\n`); log(out); renderTables({reactions:res.reactions,memberForces:res.memberForces}); }catch(e){alert(e.message);} }
function draw3D(data,forces){
  const cv=$('canvas'), ctx=cv.getContext('2d'); ctx.clearRect(0,0,cv.width,cv.height); const pts=Object.values(data.nodes); const coords=[]; function proj(p){ const X=(p.x-p.y)*0.75; const Y=(p.x+p.y)*0.38-p.z*0.9; return {X,Y}; } pts.forEach(p=>coords.push(proj(p))); const xs=coords.map(p=>p.X), ys=coords.map(p=>p.Y), minX=Math.min(...xs),maxX=Math.max(...xs),minY=Math.min(...ys),maxY=Math.max(...ys), pad=70, sc=Math.min((cv.width-2*pad)/Math.max(maxX-minX,1),(cv.height-2*pad)/Math.max(maxY-minY,1)); function P(p){ const q=proj(p); return {x:pad+(q.X-minX)*sc, y:pad+(q.Y-minY)*sc}; } const maxF=Math.max(...(forces?Object.values(forces).map(Math.abs):[1]),1); Object.entries(data.members).forEach(([mid,m])=>{ const a=P(data.nodes[m.n1]), b=P(data.nodes[m.n2]), f=forces?forces[mid]:0; ctx.strokeStyle=!forces?'gray':Math.abs(f)<1e-6?'gray':f>0?'red':'blue'; ctx.lineWidth=!forces?3:3+5*Math.abs(f)/maxF; ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke(); ctx.fillStyle='#111'; ctx.textAlign='center'; ctx.fillText(mid,(a.x+b.x)/2,(a.y+b.y)/2); }); Object.entries(data.nodes).forEach(([n,p])=>{ const q=P(p); ctx.fillStyle='#111'; ctx.beginPath(); ctx.arc(q.x,q.y,6,0,Math.PI*2); ctx.fill(); ctx.font='bold 15px Arial'; ctx.fillText(n,q.x,q.y-10); }); }
function loadExample3D(){ $('nodes3d').value=`A,0,0,0\nB,2,0,0\nC,0,2,0\nD,0,0,2`; $('members3d').value=`AB,A,B\nAC,A,C\nAD,A,D\nBC,B,C\nBD,B,D\nCD,C,D`; $('supports3d').value=`A,xyz\nB,yz\nC,z`; $('loads3d').value=`D,0,0,-100`; const data=parse3D(); draw3D(data,null); log('已載入 3D 空間桁架範例。'); }

