    Object.entries(data.members).forEach(([mid,m])=>{ if(m.n1!==node&&m.n2!==node) return; const u=unitAtJoint(data,m,node), f=result.success?result.memberForces[mid]:0; const color=Math.abs(f)<1e-6?'gray':f>0?'red':'blue'; drawArrow(ctx,cx,cy,cx+u.ux*R,cy-u.uy*R,color,4); ctx.fillStyle=color; ctx.font='15px Arial'; ctx.fillText(`${mid} ${fmt(f)}`,cx+u.ux*(R+35),cy-u.uy*(R+35)); notes+=`桿件 ${mid}: 內力=${fmt(f)}，${forceState(f)}\n`; });
    const L=data.loads[node]||{fx:0,fy:0}; if(Math.hypot(L.fx,L.fy)>EPS){ const mag=Math.hypot(L.fx,L.fy), ux=L.fx/mag, uy=L.fy/mag; drawArrow(ctx,cx,cy,cx+ux*100,cy-uy*100,'green',4); notes+=`外力: Fx=${fmt(L.fx)}, Fy=${fmt(L.fy)}\n`; }
